<application>
  <component name="PostfixTemplates">
    <template id="logd@userDefined" key=".logd" provider="builtin.js" language-level="ES6" topmost="true">
      <conditions />
      <template name="fakeKey" value="console.log('$EXPR$ :',  $EXPR$)" toReformat="true" toShortenFQNames="true" />
    </template>
    <template id="dd@userDefined" key=".dd" provider="builtin.php" topmost="false">
      <conditions />
      <template name="fakeKey" value="dd($EXPR$);" toReformat="true" toShortenFQNames="true" />
    </template>
  </component>
</application>